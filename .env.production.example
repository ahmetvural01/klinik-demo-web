# Render / Neon production-demo ortamı için şablon.
# Bu dosya örnektir; gerçek değerler Render Environment ekranına girilmelidir.

NODE_ENV="production"
APP_URL="https://RENDER-SERVICE.onrender.com"
APP_NAME="KlinikCep"

# Neon PostgreSQL direct connection string.
# Örnek format:
# postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&schema=public
DATABASE_URL=""

# Güçlü ve benzersiz üretim değerleri kullanın.
JWT_SECRET=""
FIELD_ENCRYPTION_KEY=""
SMTP_MASTER_PASSWORD=""

# Meta WhatsApp Business Platform (Cloud API + Embedded Signup).
META_APP_ID=""
META_APP_SECRET=""
META_EMBEDDED_SIGNUP_CONFIG_ID=""
META_WEBHOOK_VERIFY_TOKEN=""
META_GRAPH_API_VERSION="v25.0"

# Demo seed ve bakım scriptleri için yerel test parolaları.
DEMO_ADMIN_PASSWORD=""
SUPERADMIN_PASSWORD=""

# Varsayılan olarak şifreli belge gövdeleri Neon'da kalıcı tutulur.
# Yüksek hacimli kurulumlarda S3 seçip aşağıdaki alanları doldurun.
DOCUMENT_STORAGE_PROVIDER="DATABASE"
DOCUMENT_S3_ENDPOINT=""
DOCUMENT_S3_REGION="auto"
DOCUMENT_S3_BUCKET=""
DOCUMENT_S3_ACCESS_KEY_ID=""
DOCUMENT_S3_SECRET_ACCESS_KEY=""
DOCUMENT_S3_FORCE_PATH_STYLE="false"

# Opsiyonel güvenlik anahtarı.
SUPERADMIN_MASTER_SECRET=""

# SMS entegrasyonu kullanılacaksa doldurun veya superadmin panelinden sağlayıcı tanımlayın.
SMS_PROVIDER="NETGSM"
NETGSM_USERCODE=""
NETGSM_PASSWORD=""
NETGSM_HEADER=""

# Güvenlik limitleri, tek kullanımlık doğrulamalar ve dağıtık kilitler için zorunlu.
REDIS_URL=""
TRUSTED_PROXY_HOPS="1"
WEB_CONCURRENCY="1"
SMS_QUEUE_KEY="ks:sms:jobs"
SMS_DEAD_LETTER_KEY="ks:sms:dead"
ENABLE_IN_PROCESS_SCHEDULER="false"

# Sadece sahte demo verisi elle yüklenecekse kullanın.
DEMO_PASSWORD=""
