generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Institution {
  id                     String                    @id @default(cuid())
  name                   String                    @unique
  email                  String                    @unique
  phone                  String?
  address                String?
  taxNo                  String?                   @unique
  registryNo             String?
  website                String?
  logo                   String?
  subscriptionPlan       SubscriptionPlan          @default(TEMEL)
  billingCycle           BillingCycle              @default(AYLIK)
  smsBalance             Int                       @default(0)
  // Yalnızca süperadmin tarafından açılabilir (klinik kendi başına
  // etkinleştiremez) — bkz. WhatsappProviderConfig yorumu.
  whatsappEnabled        Boolean                   @default(false)
  isActive               Boolean                   @default(true)
  ownerId                String?                   @unique
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  adIntensity            AdIntensity               @default(MEDIUM)
  adsEnabled             Boolean                   @default(false)
  maxActiveDoctors       Int?
  maxActiveUsers         Int?
  maxActiveBranches      Int?
  paymentGraceUntil      DateTime?
  serviceMode            ServiceMode               @default(NORMAL)
  serviceNote            String?
  suspendedUntil         DateTime?
  throttleMs             Int                       @default(0)
  isDemo                 Boolean                   @default(false)
  demoExpiresAt          DateTime?
  demoSourceRequestId    String?
  owner                  User?                     @relation("InstitutionOwner", fields: [ownerId], references: [id])
  adAssignments          InstitutionAdAssignment[]
  announcements          Announcement[]
  clinicTasks            ClinicTask[]
  examinations           Examination[]
  prescriptions          Prescription[]
  treatmentPlans         TreatmentPlan[]
  labOrders              LabOrder[]
  taksitPlans            TaksitPlan[]
  firmaIslemler          FirmaIslem[]
  doctorRateHistory      DoctorRateHistory[]
  demoRequests           DemoRequest[]             @relation("DemoRequestInstitution")
  invoices               Invoice[]
  patients               Patient[]
  priceItems             PriceItem[]
  settings               Setting?
  smsTransactions        SmsTransaction[]
  stockItems             StockItem[]
  stockMovements         StockMovement[]
  stockLots              StockLot[]
  expenseCategories      ExpenseCategory[]
  expenses               Expense[]
  firmas                 Firma[]
  purchases              Purchase[]
  posDevices             PosDevice[]
  payments               Payment[]
  users                  User[]
  supportTickets         SupportTicket[]
  whatsappProviders      WhatsappProviderConfig[]
  whatsappSignupSessions WhatsappSignupSession[]
  whatsappMessages       WhatsappMessage[]
  messages               Message[]
  documents              Document[]
  waitlistEntries        Waitlist[]
  bookingRequests        BookingRequest[]
  treatmentTypes         TreatmentType[]
  consentTemplates       ConsentTemplate[]
  patientConsents        PatientConsent[]
  smsTemplates           SmsTemplate[]
  packageDefinitions     PackageDefinition[]
  patientPackages        PatientPackage[]
  clinicUnits            ClinicUnit[]
  branches               ClinicBranch[]
  appointments           Appointment[]
  doctorBlocks           DoctorBlock[]
  celebrationDaySettings CelebrationDaySetting[]
  patientFollowUps       PatientFollowUp[]
  patientFollowUpEvents  PatientFollowUpEvent[]
  reminders              Reminder[]
  smsDispatches          SmsDispatch[]
  clinicTaskAssignees    ClinicTaskAssignee[]
  paymentRevisions       PaymentRevision[]
  treatmentSteps         TreatmentStep[]
  patientPackageUsages   PatientPackageUsage[]
  labTrips               LabTrip[]
  labOrderInvoices       LabOrderInvoice[]
  stockLotAllocations    StockMovementLotAllocation[]
  taksitler              Taksit[]
  taksitOdemeleri        TaksitOdeme[]
  birthdaySmsLogs        BirthdaySmsLog[]
  celebrationSmsLogs     CelebrationSmsLog[]
  firmaPaymentAllocations FirmaPaymentAllocation[]
  firmaKontaktler        FirmaKontakt[]
  purchaseItems          PurchaseItem[]
  whatsappTemplates      WhatsappTemplate[]
  invoiceReminders       InvoiceReminder[]
  taksitReminderLogs     TaksitReminderLog[]
}

// Kurumun fiziksel hizmet noktası. Institution abonelik ve tenant sınırı,
// ClinicBranch ise aynı kuruma bağlı operasyon/raporlama sınırıdır.
model ClinicBranch {
  id              String              @id @default(cuid())
  institutionId   String
  name            String
  code            String?
  slug            String
  phone           String?
  email           String?
  address         String?
  district        String?
  city            String?
  timeZone        String              @default("Europe/Istanbul")
  colorCode       String              @default("#0f766e")
  isHeadquarters  Boolean             @default(false)
  isActive        Boolean             @default(true)
  sortOrder       Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  institution     Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  memberships     UserBranch[]
  clinicUnits     ClinicUnit[]
  appointments    Appointment[]
  homePatients    Patient[]           @relation("PatientHomeBranch")
  clinicTasks     ClinicTask[]
  examinations    Examination[]
  payments        Payment[]
  prescriptions   Prescription[]
  treatmentPlans  TreatmentPlan[]
  patientPackages PatientPackage[]
  labOrders       LabOrder[]
  stockItems      StockItem[]
  stockMovements  StockMovement[]
  stockLots       StockLot[]
  taksitPlans     TaksitPlan[]
  posDevices      PosDevice[]
  expenses        Expense[]
  firmaIslemler   FirmaIslem[]
  firmas          Firma[]
  purchases       Purchase[]
  doctorRates     DoctorRateHistory[]
  waitlistEntries Waitlist[]
  bookingRequests BookingRequest[]
  doctorBlocks    DoctorBlock[]
  messages        Message[]
  patientFollowUps PatientFollowUp[]
  patientFollowUpEvents PatientFollowUpEvent[]
  reminders       Reminder[]
  smsDispatches   SmsDispatch[]
  whatsappMessages WhatsappMessage[]
  clinicTaskAssignees ClinicTaskAssignee[]
  paymentRevisions PaymentRevision[]
  treatmentSteps TreatmentStep[]
  patientPackageUsages PatientPackageUsage[]
  labTrips LabTrip[]
  labOrderInvoices LabOrderInvoice[]
  stockLotAllocations StockMovementLotAllocation[]
  taksitler Taksit[]
  taksitOdemeleri TaksitOdeme[]
  birthdaySmsLogs BirthdaySmsLog[]
  celebrationSmsLogs CelebrationSmsLog[]
  firmaPaymentAllocations FirmaPaymentAllocation[]
  firmaKontaktler FirmaKontakt[]
  purchaseItems PurchaseItem[]
  taksitReminderLogs TaksitReminderLog[]

  @@unique([institutionId, name])
  @@unique([institutionId, code])
  @@unique([institutionId, slug])
  @@unique([id, institutionId])
  @@index([institutionId, isActive, sortOrder])
}

// Klinik içindeki fiziksel çalışma alanı (ünit, oda veya koltuk). Randevuya
// opsiyonel bağlanır; bir ünite seçildiyse aynı zaman aralığında ikinci
// randevu açılmasına izin verilmez. Böylece çok hekimli kliniklerde koltuk
// kapasitesi görünmez bir darboğaz olmaktan çıkar.
model ClinicUnit {
  id            String        @id @default(cuid())
  institutionId String
  branchId      String
  name          String
  code          String?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  institution   Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  branch        ClinicBranch  @relation(fields: [branchId, institutionId], references: [id, institutionId], onDelete: Cascade)
  appointments  Appointment[]

  @@unique([branchId, name])
  @@unique([branchId, code])
  @@unique([id, institutionId, branchId])
  @@index([institutionId, branchId, isActive])
}

model DemoRequest {
  id                String       @id @default(cuid())
  institutionName   String
  contactName       String
  email             String
  phone             String?
  notes             String?
  status            String       @default("DEMO_CREATED")
  demoInstitutionId String?
  demoExpiresAt     DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  demoInstitution   Institution? @relation("DemoRequestInstitution", fields: [demoInstitutionId], references: [id])

  @@index([email])
  @@index([status])
  @@index([demoInstitutionId])
  @@index([createdAt])
}

model Advertisement {
  id             String                    @id @default(cuid())
  title          String
  content        String
  imageUrl       String?
  ctaText        String?
  ctaUrl         String?
  sponsorName    String?
  priority       Int                       @default(100)
  isActive       Boolean                   @default(true)
  startAt        DateTime?
  endAt          DateTime?
  maxImpressions Int?
  dailyCap       Int?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  assignments    InstitutionAdAssignment[]

  @@index([isActive, priority])
}

model InstitutionAdAssignment {
  id              String        @id @default(cuid())
  institutionId   String
  advertisementId String
  isActive        Boolean       @default(true)
  weight          Int           @default(100)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  advertisement   Advertisement @relation(fields: [advertisementId], references: [id])
  institution     Institution   @relation(fields: [institutionId], references: [id])

  @@unique([institutionId, advertisementId])
  @@index([institutionId, isActive])
}

model SmsPackage {
  id           String           @id @default(cuid())
  name         String
  smsCount     Int              @unique
  price        Decimal          @db.Decimal(10, 2)
  description  String?
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  transactions SmsTransaction[]
}

model SmsTransaction {
  id            String      @id @default(cuid())
  institutionId String
  smsPackageId  String
  quantity      Int         @default(1)
  totalPrice    Decimal     @db.Decimal(10, 2)
  balanceBefore Int
  balanceAfter  Int
  status        String      @default("COMPLETED")
  createdAt     DateTime    @default(now())
  institution   Institution @relation(fields: [institutionId], references: [id])
  smsPackage    SmsPackage  @relation(fields: [smsPackageId], references: [id])

  @@index([institutionId])
  @@index([createdAt])
}

model PlatformSmsWallet {
  id               Int                   @id @default(autoincrement())
  availableBalance Int                   @default(0)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  purchases        PlatformSmsPurchase[]
}

model PlatformSmsPurchase {
  id        String            @id @default(cuid())
  walletId  Int
  quantity  Int
  unitCost  Decimal?          @db.Decimal(10, 2)
  totalCost Decimal?          @db.Decimal(10, 2)
  provider  String?
  note      String?
  createdAt DateTime          @default(now())
  wallet    PlatformSmsWallet @relation(fields: [walletId], references: [id])
}

// institutionId null = sistem varsayılanı (süperadmin yönetir, tüm klinikler
// için geçerli); dolu = kliniğin kendi özelleştirdiği/eklediği şablon. Aynı
// code için klinik satırı varsa o öncelikli, yoksa null (varsayılan) satır
// kullanılır — bkz. src/lib/sms-templates.ts resolveSmsTemplate().
// NOT: Postgres'te NULL @@unique karşılaştırmasında eşit sayılmaz, yani bu
// kısıt kliniğe-özel satırlarda gerçek bir DB kısıtı sağlar ama sistem
// varsayılanları (institutionId=null) arasındaki code benzersizliğini DB
// garanti etmez — bu, süperadmin route'unda uygulama seviyesinde kontrol edilir.
model SmsTemplate {
  id                       String       @id @default(cuid())
  institutionId            String?
  code                     String
  title                    String
  description              String?
  category                 String       @default("GENERAL")
  content                  String
  whatsappContent          String?
  whatsappTemplateName     String?
  whatsappTemplateLanguage String       @default("tr")
  isActive                 Boolean      @default(true)
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
  institution              Institution? @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([institutionId, code])
  @@index([code])
}

model SmsProviderConfig {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  isActive       Boolean  @default(false)
  priority       Int      @default(100)
  sendUrl        String?
  balanceUrl     String?
  httpMethod     String   @default("POST")
  username       String?
  password       String?
  apiKey         String?
  sender         String?
  headersJson    String?
  bodyTemplate   String?
  successPattern String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model MockSmsLog {
  id           String   @id @default(cuid())
  phone        String
  message      String
  sender       String?
  status       String   @default("SENT")
  responseData String?
  createdAt    DateTime @default(now())
}

// WhatsApp, SMS'e paralel bir bildirim kanalı olarak eklendi. Amaç: SMS gönderimi
// klinik başına satılan bir kredi tükettiği için gelir kaynağıdır; WhatsApp ise
// yalnızca süperadmin'in "WhatsApp modülünü kullanabilir" yetkisini açtığı
// kliniklerde SMS kredisi tüketmeden aynı süreçleri (randevu bilgilendirme,
// hatırlatma, toplu gönderim vb.) yürütür. Her kaydın institutionId'si
// zorunludur — platform genelinde paylaşılan/ortak bir WhatsApp sağlayıcısı
// (institutionId: null fallback) kasıtlı olarak desteklenmez: bir kliniğin
// mesajı hiçbir zaman başka bir ortak numaradan gitmemelidir. Klinik kendi
// Meta Business hesabını bu tablo üzerinden tanımlar (bkz. src/lib/whatsapp.ts).
model WhatsappProviderConfig {
  id                          String                   @id @default(cuid())
  institutionId               String
  code                        String
  name                        String
  providerType                String                   @default("CUSTOM")
  isActive                    Boolean                  @default(false)
  priority                    Int                      @default(100)
  sendUrl                     String?
  httpMethod                  String                   @default("POST")
  username                    String?
  password                    String?
  apiKey                      String?
  sender                      String?
  headersJson                 String?
  bodyTemplate                String?
  successPattern              String?
  phoneNumberId               String?
  businessAccountId           String?
  businessId                  String?
  displayPhoneNumber          String?
  verifiedName                String?
  accessTokenEncrypted        String?
  registrationPinEncrypted    String?
  tokenExpiresAt              DateTime?
  connectionStatus            WhatsappConnectionStatus @default(NOT_CONNECTED)
  connectionError             String?
  connectedAt                 DateTime?
  disconnectedAt              DateTime?
  lastWebhookAt               DateTime?
  lastSuccessfulSendAt        DateTime?
  verifyToken                 String?
  appSecret                   String?
  apiVersion                  String                   @default("v25.0")
  appointmentTemplateName     String?
  appointmentTemplateLanguage String                   @default("tr")
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt
  institution                 Institution              @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  templates                   WhatsappTemplate[]
  messages                    WhatsappMessage[]

  @@unique([institutionId, code])
  @@unique([id, institutionId])
  @@unique([phoneNumberId])
  @@index([institutionId, isActive])
}

model WhatsappSignupSession {
  id            String      @id @default(cuid())
  institutionId String
  userId        String
  stateHash     String      @unique
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime    @default(now())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([institutionId, expiresAt])
}

model MockWhatsappLog {
  id           String   @id @default(cuid())
  phone        String
  message      String
  sender       String?
  status       String   @default("SENT")
  responseData String?
  createdAt    DateTime @default(now())
}

model WhatsappTemplate {
  id             String                 @id @default(cuid())
  institutionId  String
  providerId     String
  name           String
  language       String                 @default("tr")
  category       String?
  status         String                 @default("UNKNOWN")
  componentsJson String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  provider       WhatsappProviderConfig @relation(fields: [providerId, institutionId], references: [id, institutionId], onDelete: Cascade)
  institution    Institution            @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([providerId, name, language])
  @@unique([id, institutionId])
  @@index([institutionId])
  @@index([providerId, status])
}

model WhatsappMessage {
  id                String                  @id @default(cuid())
  institutionId     String
  branchId          String
  providerId        String?
  patientId         String?
  appointmentId     String?
  externalMessageId String?
  contextMessageId  String?
  direction         String
  status            String
  phone             String
  content           String?
  templateName      String?
  errorDetail       String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  seenAt            DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  institution       Institution             @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  branch            ClinicBranch            @relation(fields: [branchId, institutionId], references: [id, institutionId], onDelete: NoAction)
  provider          WhatsappProviderConfig? @relation(fields: [providerId, institutionId], references: [id, institutionId], onDelete: NoAction)
  patient           Patient?                @relation(fields: [patientId, institutionId, branchId], references: [id, institutionId, homeBranchId], onDelete: NoAction)
  appointment       Appointment?            @relation(fields: [appointmentId, institutionId, branchId], references: [id, institutionId, branchId], onDelete: NoAction)

  @@index([institutionId, branchId, createdAt])
  @@index([institutionId, status])
  @@index([institutionId, direction, seenAt])
  @@index([patientId, createdAt])
  @@index([phone, createdAt])
  @@unique([institutionId, externalMessageId])
}

model Invoice {
  id            String            @id @default(cuid())
  institutionId String
  invoiceNo     String            @unique
  amount        Decimal           @db.Decimal(10, 2)
  description   String?
  status        InvoiceStatus     @default(PENDING)
  dueDate       DateTime?
  paidAt        DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  institution   Institution       @relation(fields: [institutionId], references: [id])
  reminders     InvoiceReminder[]

  @@index([institutionId])
  @@index([status])
  @@index([dueDate])
  @@index([institutionId, status])
  @@unique([id, institutionId])
}

model InvoiceReminder {
  id            String      @id @default(cuid())
  institutionId String
  invoiceId     String
  channel       String
  sentTo        String
  status        String
  message       String?
  errorDetail   String?
  sentAt        DateTime    @default(now())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: NoAction)
  invoice       Invoice     @relation(fields: [invoiceId, institutionId], references: [id, institutionId], onDelete: NoAction)

  @@index([invoiceId])
}

model SmtpConfig {
  id        Int      @id @default(1)
  host      String   @default("")
  port      Int      @default(587)
  secure    Boolean  @default(false)
  username  String   @default("")
  password  String   @default("")
  fromName  String   @default("KlinikCep")
  fromEmail String   @default("noreply@klinik.local")
  isActive  Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

// Rol bazlı yetki matrisi — tüm platform için tek, sistem geneli kayıt.
// ÖNCEDEN data/role-permissions.json dosyasında tutuluyordu; Render'ın
// ephemeral dosya sisteminde her redeploy'da süperadmin'in yaptığı özel
// yetki değişiklikleri sessizce kayboluyordu (bkz. README_DEPLOYMENT.md).
model RolePermissionConfig {
  id        Int      @id @default(1)
  version   Int      @default(1)
  updatedBy String   @default("system")
  map       Json
  updatedAt DateTime @updatedAt
}

// Tüm platform için tek, sistem geneli aktif görsel tema (renk paleti + yazı
// tipi). Kurum bazlı değil — SiteContent gibi tek satırlık bir singleton.
model PlatformTheme {
  id          Int      @id @default(1)
  activeTheme String   @default("klasik")
  updatedAt   DateTime @updatedAt
}

model SiteContent {
  id                Int      @id @default(1)
  heroBadge         String   @default("Dis Hekimi Klinikleri Icin Uretildi")
  heroTitle         String   @default("Randevudan kasaya, tum surecler tek bir profesyonel sistemde.")
  heroDescription   String   @default("Hasta kayıt, randevu planlama, tedavi takibi, ödeme yönetimi, SMS/e-posta hatırlatma ve raporlama modüllerini bir arada sunar.")
  primaryCtaLabel   String   @default("Hemen Giris Yap")
  primaryCtaUrl     String   @default("/klinik/giris")
  secondaryCtaLabel String   @default("Fiyatlari Incele")
  secondaryCtaUrl   String   @default("#fiyatlar")
  promoTitle        String   @default("Program Demo ve Tanitim Talebi")
  promoDescription  String   @default("Kliniğinize özel senaryo üzerinden canlı tanıtım alarak modülleri gerçek kullanım akışında görebilirsiniz.")
  promoVideoUrl     String?
  heroImageUrl      String?
  featureCards      Json
  pricingCards      Json
  statsCards        Json
  moduleCards       Json
  galleryImages     Json
  showAnimations    Boolean  @default(true)
  updatedAt         DateTime @updatedAt
}

model User {
  id                      String                 @id @default(cuid())
  // TC kimlik no SADECE kurum içinde benzersizdir (bkz. @@unique([institutionId, identityNo])
  // aşağıda) — global @unique KASITLI OLARAK kaldırıldı. Aksi halde iki farklı klinik
  // aynı TC'ye (rastgele çakışma veya test verisi) sahip personel ekleyemez, hatta
  // birinin kaydı diğerini bulan sorgularla karışabilirdi (kritik çoklu kiracı hatası).
  identityNo              String
  fullName                String
  email                   String?                @unique
  passwordHash            String
  // Yeni personel eklendiğinde şifre sorulmadan varsayılan olarak TC kimlik
  // no atanır; bu bayrak true iken kullanıcı giriş yaptıktan sonra doğrudan
  // profil/şifre değiştirme adımına yönlendirilir (bkz. kullanıcı geri
  // bildirimi — akıcı personel ekleme süreci).
  mustChangePassword      Boolean                @default(false)
  // Sunucu taraflı oturum iptali için: şifre değiştiğinde veya kullanıcı
  // "diğer tüm cihazlardan çıkış yap" dediğinde bu sayı artırılır. JWT'ye
  // gömülen tokenVersion bu değerle eşleşmezse token geçersiz sayılır —
  // önceden logout yalnızca çerezi temizliyordu, çalınmış/eski bir token
  // doğal 7 günlük süresi dolana kadar geçerliliğini koruyordu.
  tokenVersion            Int                    @default(0)
  role                    Role                   @default(DOKTOR)
  isActive                Boolean                @default(true)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  institutionId           String?
  genelYuzde              Decimal?               @db.Decimal(5, 2)
  kkYuzde                 Decimal?               @db.Decimal(5, 2)
  maasYuzde               Decimal?               @db.Decimal(5, 2)
  appointments            Appointment[]
  logs                    AuditLog[]
  examinations            Examination[]
  ownedInstitution        Institution?           @relation("InstitutionOwner")
  labOrders               LabOrder[]             @relation("LabOrderDoctor")
  paymentsAsDoctor        Payment[]              @relation("PaymentDoctor")
  prescriptions           Prescription[]         @relation("PrescriptionDoctor")
  messages                Message[]
  profile                 Profile?
  assignedFollowUps       PatientFollowUp[]      @relation("FollowUpAssignedDoctor")
  createdFollowUps        PatientFollowUp[]      @relation("FollowUpCreatedBy")
  createdFollowEvents     PatientFollowUpEvent[] @relation("FollowUpEventCreatedBy")
  updatedFollowEvents     PatientFollowUpEvent[] @relation("FollowUpEventUpdatedBy")
  stockMovements          StockMovement[]        @relation("StockMovementUser")
  superadminPermission    SuperadminPermission?
  supportTickets          SupportTicket[]
  taksitPlanlari          TaksitPlan[]           @relation("TaksitPlanDoctor")
  treatmentPlans          TreatmentPlan[]        @relation("TreatmentPlanDoctor")
  doctorBlocks            DoctorBlock[]
  assignedClinicTasks     ClinicTask[]           @relation("ClinicTaskAssignedUser")
  clinicTaskAssignments   ClinicTaskAssignee[]
  createdClinicTasks      ClinicTask[]           @relation("ClinicTaskCreatedBy")
  institution             Institution?           @relation(fields: [institutionId], references: [id])
  uploadedDocuments       Document[]
  createdConsents         PatientConsent[]       @relation("ConsentCreatedBy")
  waitlistCreated         Waitlist[]             @relation("WaitlistCreatedBy")
  waitlistAsDoctor        Waitlist[]             @relation("WaitlistDoctor")
  bookingRequestsAsDoctor BookingRequest[]
  doctorPayoutExpenses    Expense[]              @relation("ExpenseDoctor")
  purchasesCreated        Purchase[]             @relation("PurchaseCreatedBy")
  twoFactorSecret         String?
  twoFactorEnabled        Boolean                @default(false)
  twoFactorBackupCodes    String?
  // Kabul edilen son TOTP zaman adımı — aynı 6 haneli kodun (ör. ele
  // geçirilmiş/gözetlenmiş bir kod) kısa süre içinde tekrar gönderilerek
  // yeniden kullanılmasını engeller (bkz. denetim raporu).
  twoFactorLastStep       Int?
  rateHistory             DoctorRateHistory[]    @relation("DoctorRateHistoryDoctor")
  patientPackagesSold     PatientPackage[]       @relation("PatientPackageDoctor")
  patientPackageUsages    PatientPackageUsage[]  @relation("PatientPackageUsageCreatedBy")
  patientAccessLogs       PatientAccessLog[]
  branchMemberships       UserBranch[]

  @@unique([institutionId, identityNo])
  @@unique([id, institutionId])
}

// Rol yetkiyi, UserBranch ise o yetkinin hangi fiziksel lokasyonlarda
// kullanılabileceğini belirler. Aynı personel birden fazla şubede çalışabilir.
model UserBranch {
  id              String       @id @default(cuid())
  institutionId   String
  userId          String
  branchId        String
  isPrimary       Boolean      @default(false)
  isActive        Boolean      @default(true)
  isBranchManager Boolean      @default(false)
  // null: rolün tüm izinleri; dizi: rol izinlerinin şube yöneticisince
  // daraltılmış alt kümesi. Bu alan hiçbir zaman rol tavanını genişletemez.
  permissionCodes Json?
  genelYuzde      Decimal?     @db.Decimal(5, 2)
  kkYuzde         Decimal?     @db.Decimal(5, 2)
  maasYuzde       Decimal?     @db.Decimal(5, 2)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  user            User         @relation(fields: [userId, institutionId], references: [id, institutionId], onDelete: Cascade)
  branch          ClinicBranch @relation(fields: [branchId, institutionId], references: [id, institutionId], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([institutionId, branchId, isActive])
  @@index([userId, isActive, isPrimary])
}

// Doktor komisyon oranları (kkYuzde/genelYuzde/maasYuzde) personel ekranından
// değiştirildiğinde, User üzerindeki alanlar sadece "şu anki" oranı tutuyordu
// — geçmiş ayların hakediş hesabı da yeni orana göre yeniden hesaplanıyor,
// zaten ödenmiş bir ayın "hakedilen" tutarı sessizce değişebiliyordu. Her
// oran değişikliği burada dönem-damgalı bir satır olarak saklanır; hakediş
// hesabı her ay için o ayın başında geçerli olan orana bakar.
model DoctorRateHistory {
  id            String       @id @default(cuid())
  institutionId String
  branchId      String
  doctorId      String
  kkYuzde       Decimal      @db.Decimal(5, 2)
  genelYuzde    Decimal      @db.Decimal(5, 2)
  maasYuzde     Decimal      @db.Decimal(5, 2)
  effectiveFrom DateTime
  createdAt     DateTime     @default(now())
  doctor        User         @relation("DoctorRateHistoryDoctor", fields: [doctorId, institutionId], references: [id, institutionId], onDelete: NoAction)
  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  branch        ClinicBranch @relation(fields: [branchId, institutionId], references: [id, institutionId], onDelete: Cascade)

  @@index([institutionId, branchId, doctorId, effectiveFrom])
}

model SuperadminPermission {
  id        String   @id @default(cuid())
  userId    String   @unique
  modules   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Profile {
  id            String   @id @default(cuid())
  userId        String   @unique
  photoUrl      String?
  workStart     String   @default("08:30")
  workEnd       String   @default("18:00")
  hideAsDoctor  Boolean  @default(false)
  educationMode Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id])
}

model Patient {
  id                         String                      @id @default(cuid())
  institutionId              String
  homeBranchId               String
  // Yabancı uyruklu hastalarda TC kimlik no zorunlu değildir (bkz. isForeigner)
  // — Postgres benzersiz indekste NULL değerler birbirinden farklı sayılır,
  // yani birden fazla TC'siz yabancı hasta kaydı çakışma yaratmaz.
  tcNo                       String?
  isForeigner                Boolean                     @default(false)
  // Telefonun ülke kodu (ör. "+90", "+49") — numara her zaman ülke kodu
  // olmadan, o ülkenin yerel formatında saklanır.
  phoneCountryCode           String                      @default("+90")
  fullName                   String
  phone                      String
  preferredContactChannel    String                      @default("SMS")
  whatsappOptInAt            DateTime?
  whatsappOptOutAt           DateTime?
  communicationConsentSource String?
  address                    String?
  profession                 String?
  gender                     String
  birthDate                  DateTime?
  insurance                  String?
  discountRate               Int                         @default(0)
  notes                      String?
  hasAllergy                 Boolean                     @default(false)
  hasHepatitis               Boolean                     @default(false)
  hasKidney                  Boolean                     @default(false)
  hasDiabetes                Boolean                     @default(false)
  hasHeart                   Boolean                     @default(false)
  hasBloodIssue              Boolean                     @default(false)
  hasContagiousDisease       Boolean                     @default(false)
  contagiousDiseaseNote      String?
  surgeries                  String?
  medications                String?
  otherDiseases              String?
  archivedAt                 DateTime?
  archivedById               String?
  archiveReason              String?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  bloodType                  String?
  toothChart                 String?
  referrer                   String?
  institution                Institution                 @relation(fields: [institutionId], references: [id])
  homeBranch                 ClinicBranch                @relation("PatientHomeBranch", fields: [homeBranchId, institutionId], references: [id, institutionId])
  appointments               Appointment[]
  examinations               Examination[]
  labOrders                  LabOrder[]
  payments                   Payment[]
  prescriptions              Prescription[]
  reminders                  Reminder[]
  followUps                  PatientFollowUp[]
  followUpEvents             PatientFollowUpEvent[]
  clinicTasks                ClinicTask[]
  taksitPlanlari             TaksitPlan[]
  treatmentPlans             TreatmentPlan[]
  documents                  Document[]
  consents                   PatientConsent[]
  waitlistEntries            Waitlist[]
  whatsappMessages           WhatsappMessage[]
  birthdaySmsLogs            BirthdaySmsLog[]
  celebrationSmsLogs         CelebrationSmsLog[]
  packages                   PatientPackage[]
  accessLogs                 PatientAccessLog[]
  smsPreference              PatientSmsPreference?
  smsPreferenceEvents        PatientSmsPreferenceEvent[]
  smsConsentTokens           PatientSmsConsentToken[]
  smsDispatches              SmsDispatch[]

  @@unique([institutionId, homeBranchId, tcNo])
  @@unique([id, institutionId])
  @@unique([id, institutionId, homeBranchId])
  @@index([institutionId])
  @@index([institutionId, archivedAt])
  @@index([homeBranchId])
  @@index([fullName])
  @@index([phone])
}

model PatientAccessLog {
  id            String   @id @default(cuid())
  institutionId String
  patientId     String
  userId        String
  action        String
  purpose       String?
  route         String?
  ip            String?
  createdAt     DateTime @default(now())
  patient       Patient  @relation(fields: [patientId, institutionId], references: [id, institutionId], onDelete: NoAction)
  user          User     @relation(fields: [userId], references: [id], onDelete: NoAction)

  @@index([institutionId, createdAt])
  @@index([patientId, createdAt])
  @@index([userId, createdAt])
}

model Appointment {
  id               String                @id @default(cuid())
  institutionId    String
  branchId         String
  patientId        String
  doctorId         String
  clinicUnitId     String?
  startAt          DateTime
  endAt            DateTime
  colorCode        String                @default("#2a9d8f")
  type             AppointmentType       @default(STANDART)
  note             String?
  smsInfo          Boolean               @default(true)
  smsReminder      Boolean               @default(false)
  smsSurvey        Boolean               @default(false)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  status           AppointmentStatus     @default(BEKLIYOR)
  institution      Institution           @relation(fields: [institutionId], references: [id])
  branch           ClinicBranch          @relation(fields: [branchId, institutionId], references: [id, institutionId])
  doctor           User                  @relation(fields: [doctorId, institutionId], references: [id, institutionId], onDelete: NoAction)
  clinicUnit       ClinicUnit?           @relation(fields: [clinicUnitId, institutionId, branchId], references: [id, institutionId, branchId], onDelete: NoAction)
  followUps        PatientFollowUp[]
  patient          Patient               @relation(fields: [patientId, institutionId, branchId], references: [id, institutionId, homeBranchId], onDelete: NoAction)
  waitlistEntries  Waitlist[]
  packageUsages    PatientPackageUsage[]
  whatsappMessages WhatsappMessage[]

  @@index([doctorId])
  @@index([patientId])
  @@index([startAt])
  @@index([doctorId, startAt])
  @@index([patientId, startAt])
  @@index([clinicUnitId, startAt])
  @@index([institutionId, branchId, startAt])
  @@unique([id, institutionId, branchId])
}

model ClinicTask {
  id            String               @id @default(cuid())
  requestKey    String?
  institutionId String
  branchId      String
  patientId     String?
  title         String
  details       String?
  vendorName    String?
  type          ClinicTaskType       @default(DIGER)
  priority      Int                  @default(2)
  status        ClinicTaskStatus     @default(ACIK)
  dueAt         DateTime?
  remindAt      DateTime?
  assignedToId  String?
  createdById   String
  completedAt   DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  institution   Institution          @relation(fields: [institutionId], references: [id])
  branch        ClinicBranch         @relation(fields: [branchId, institutionId], references: [id, institutionId])
  patient       Patient?             @relation(fields: [patientId, institutionId, branchId], references: [id, institutionId, homeBranchId], onDelete: NoAction)
  assignedTo    User?                @relation("ClinicTaskAssignedUser", fields: [assignedToId, institutionId], references: [id, institutionId], onDelete: NoAction)
  assignees     ClinicTaskAssignee[]
  createdBy     User                 @relation("ClinicTaskCreatedBy", fields: [createdById, institutionId], references: [id, institutionId], onDelete: NoAction)

  @@unique([branchId, requestKey])
  @@unique([id, institutionId, branchId])
  @@index([institutionId, branchId, status, dueAt])
  @@index([institutionId, patientId])
  @@index([assignedToId, status])
}

model ClinicTaskAssignee {
  id            String       @id @default(cuid())
  institutionId String
  branchId      String
  taskId        String
  userId        String
  createdAt     DateTime     @default(now())
  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: NoAction)
  branch        ClinicBranch @relation(fields: [branchId, institutionId], references: [id, institutionId], onDelete: NoAction)
  task          ClinicTask   @relation(fields: [taskId, institutionId, branchId], references: [id, institutionId, branchId], onDelete: Cascade)
  user          User         @relation(fields: [userId, institutionId], references: [id, institutionId], onDelete: NoAction)

  @@unique([taskId, userId])
  @@index([userId])
  @@index([taskId])
}

model PatientFollowUp {
  id             String                 @id @default(cuid())
  institutionId  String
  branchId       String
  patientId      String
  appointmentId  String?
  doctorId       String?
  createdById    String
  type           FollowUpType           @default(GERI_ARA)
  priority       Int                    @default(2)
  status         String                 @default("ACIK")
  note           String?
  resolutionNote String?
  nextActionAt   DateTime?
  lastContactAt  DateTime?
  closedAt       DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  // Lab provası nedeniyle açılan takiplerin kaynağı önceden yalnızca `note`
  // metnine gömülü "LAB_ORDER:"/"LAB_PROVA:" etiketleriyle bulunuyordu — not
  // düzenlenirse bağ sessizce kopuyordu (bkz. denetim raporu Tema 3).
  labOrderId     String?
  labTripId      String?
  institution    Institution            @relation(fields: [institutionId], references: [id], onDelete: NoAction)
  branch         ClinicBranch           @relation(fields: [branchId, institutionId], references: [id, institutionId], onDelete: NoAction)
  appointment    Appointment?           @relation(fields: [appointmentId, institutionId, branchId], references: [id, institutionId, branchId], onDelete: NoAction)
  assignedDoctor User?                  @relation("FollowUpAssignedDoctor", fields: [doctorId, institutionId], references: [id, institutionId], onDelete: NoAction)
  createdBy      User                   @relation("FollowUpCreatedBy", fields: [createdById], references: [id], onDelete: NoAction)
  patient        Patient                @relation(fields: [patientId, institutionId, branchId], references: [id, institutionId, homeBranchId], onDelete: NoAction)
  labOrder       LabOrder?              @relation(fields: [labOrderId, institutionId, branchId], references: [id, institutionId, branchId], onDelete: NoAction)
  labTrip        LabTrip?               @relation(fields: [labTripId, institutionId, branchId], references: [id, institutionId, branchId], onDelete: NoAction)
  events         PatientFollowUpEvent[]

  @@index([patientId])
  @@index([appointmentId])
  @@index([doctorId])
  @@index([createdById])
  @@index([status, nextActionAt])
  @@index([createdAt])
  @@index([labOrderId])
  @@index([labTripId])
  @@unique([id, institutionId, branchId])
  @@index([institutionId, branchId, status, nextActionAt])
}

model PatientFollowUpEvent {
  id              String          @id @default(cuid())
  institutionId   String
  branchId        String
  followUpId      String
  patientId       String
  occurredAt      DateTime
  channel         String?
  summary         String
  detail          String?
  patientResponse String?
  nextStep        String?
  createdById     String
  updatedById     String
  voidedAt        DateTime?
  voidedById      String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  institution     Institution     @relation(fields: [institutionId], references: [id], onDelete: NoAction)
  branch          ClinicBranch    @relation(fields: [branchId, institutionId], references: [id, institutionId], onDelete: NoAction)
  followUp        PatientFollowUp @relation(fields: [followUpId, institutionId, branchId], references: [id, institutionId, branchId], onDelete: Cascade)
  patient         Patient         @relation(fields: [patientId, institutionId, branchId], references: [id, institutionId, homeBranchId], onDelete: NoAction)
  createdBy       User            @relation("FollowUpEventCreatedBy", fields: [createdById], references: [id], onDelete: NoAction)
  updatedBy       User            @relation("FollowUpEventUpdatedBy", fields: [updatedById], references: [id], onDelete: NoAction)

  @@index([followUpId, occurredAt])
  @@index([patientId, occurredAt])
  @@index([createdAt])
  @@index([institutionId, branchId, occurredAt])
  @@index([institutionId, branchId, voidedAt])
  @@unique([id, institutionId, branchId])
}

model ConsentTemplate {
  id            String           @id @default(cuid())
  institutionId String?
  title         String
  category      String           @default("TEDAVI_ONAM")
  body          String
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  institution   Institution?     @relation(fields: [institutionId], references: [id])
  consents      PatientConsent[]

  @@index([institutionId, isActive])
  @@index([category])
}

model PatientConsent {
  id               String           @id @default(cuid())
  institutionId    String
  patientId        String
  templateId       String?
  title            String
  category         String           @default("TEDAVI_ONAM")
  body             String
  signerName       String
  signerIdentityNo String?
  signatureDataUrl String
  status           String           @default("AKTIF")
  voidedAt         DateTime?
  voidReason       String?
  voidedById       String?
  signedAt         DateTime         @default(now())
  createdById      String
  createdAt        DateTime         @default(now())
  patient          Patient          @relation(fields: [patientId, institutionId], references: [id, institutionId], onDelete: NoAction)
  template         ConsentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdBy        User             @relation("ConsentCreatedBy", fields: [createdById], references: [id], onDelete: NoAction)
  institution      Institution      @relation(fields: [institutionId], references: [id])

  @@index([institutionId])
  @@index([status])
  @@index([patientId, signedAt])
  @@index([templateId])
}

model Examination {
  id            String       @id @default(cuid())
  institutionId String
  branchId      String
  patientId     String
  doctorId      String
  treatmentName String
  toothNo       String?
  amount        Decimal      @db.Decimal(10, 2)
  status        String
  diagnosedAt   DateTime
  note          String?
  createdAt     DateTime     @default(now())
  doctor        User         @relation(fields: [doctorId, institutionId], references: [id, institutionId], onDelete: NoAction)
  patient       Patient      @relation(fields: [patientId, institutionId, branchId], references: [id, institutionId, homeBranchId], onDelete: NoAction)
  institution   Institution  @relation(fields: [institutionId], references: [id])
  branch        ClinicBranch @relation(fields: [branchId, institutionId], references: [id, institutionId])

  @@index([patientId])
  @@index([doctorId])
  @@index([institutionId, branchId, patientId, diagnosedAt])
  @@index([doctorId, diagnosedAt])
  @@index([patientId, status, diagnosedAt])
  @@unique([id, institutionId, branchId])
}

model Payment {
  id             String            @id @default(cuid())
  institutionId  String
  branchId       String
  requestKey     String?
  patientId      String?
  doctorId       String?
  method         PaymentMethod     @default(NAKIT)
  amount         Decimal           @db.Decimal(10, 2)
  description    String?
  status         String            @default("ACTIVE")
  voidedAt       DateTime?
  voidedById     String?
  voidReason     String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  posId          String?
  institution    Institution       @relation(fields: [institutionId], references: [id])
  branch         ClinicBranch      @relation(fields: [branchId, institutionId], references: [id, institutionId])
  patient        Patient?          @relation(fields: [patientId, institutionId, branchId], references: [id, institutionId, homeBranchId], onDelete: NoAction)
  doctor         User?             @relation("PaymentDoctor", fields: [doctorId, institutionId], references: [id, institutionId], onDelete: NoAction)
  pos            PosDevice?        @relation(fields: [posId, institutionId, branchId], references: [id, institutionId, branchId], onDelete: NoAction)
  taksitOdemeler TaksitOdeme[]
  patientPackage PatientPackage?
  revisions      PaymentRevision[]

  @@unique([branchId, requestKey])
  @@index([institutionId, branchId, status, createdAt])
  @@index([patientId])
  @@index([doctorId])
  @@index([patientId, status, createdAt])
  @@index([doctorId, status, createdAt])
  @@index([posId])
  @@index([createdAt])
  @@unique([id, institutionId, branchId])
}

model PaymentRevision {
  id            String       @id @default(cuid())
  institutionId String
  branchId      String
  paymentId     String
  actorId       String?
  action        String
  beforeData    Json
  afterData     Json?
  reason        String?
  createdAt     DateTime     @default(now())
  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: NoAction)
  branch        ClinicBranch @relation(fields: [branchId, institutionId], references: [id, institutionId], onDelete: NoAction)
  payment       Payment      @relation(fields: [paymentId, institutionId, branchId], references: [id, institutionId, branchId], onDelete: Restrict)

  @@index([paymentId, createdAt])
  @@index([actorId, createdAt])
}

model PriceItem {
  id            String      @id @default(cuid())
  institutionId String
  code          String
  treatment     String
  amount        Decimal     @db.Decimal(10, 2)
  isFavorite    Boolean     @default(false)
  isCustom      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  institution   Institution @relation(fields: [institutionId], references: [id])

  @@unique([institutionId, code, treatment])
  @@index([institutionId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  branchId  String?
  action    String
  detail    String?
  /// Gerçek işlemi yapan kullanıcı (ghost/superadmin oturumlarında userId'den farklı olabilir)
  actorId   String?
  actorRole String?
  isGhost   Boolean  @default(false)
  ip        String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction)

  @@index([userId])
  @@index([createdAt])
  @@index([actorId])
  @@index([userId, createdAt])
  @@index([branchId, createdAt])
}

model Setting {
  id                              String              @id @default(cuid())
  institutionName                 String
  institutionAddress              String?
  institutionPhone                String?
  institutionWebsite              String?
  openingTime                     String              @default("08:30")
  closingTime                     String              @default("23:00")
  appointmentDuration             Int                 @default(15)
  holidayDays                     String              @default("[]")
  // Günlük özel çalışma saatleri: JSON array of {day:"pazartesi",open:"08:30",close:"17:00",lunchStart:"12:00",lunchEnd:"13:00",isHoliday:false}
  dailySchedules                  String              @default("[]")
  // Genel öğle arası (günlük override yoksa kullanılır)
  lunchStart                      String              @default("")
  lunchEnd                        String              @default("")
  smsEnabled                      Boolean             @default(true)
  smsDefaultInfo                  Boolean             @default(true)
  smsDefaultReminder              Boolean             @default(false)
  smsDefaultSurvey                Boolean             @default(false)
  // Hastanın taksit/ödeme vadesi yaklaştığında veya geciktiğinde otomatik SMS
  // gönderilsin mi (bkz. src/lib/patient-payment-reminders.ts). Varsayılan
  // kapalı: SMS kurumun kendi bakiyesinden düşer, bu yüzden bilinçli açılmalı.
  paymentReminderSmsEnabled       Boolean             @default(false)
  // Ödeme hatırlatması vadeden kaç gün önce gönderilsin (klinik ayarlanabilir).
  paymentReminderWindowDays       Int                 @default(3)
  // Birden fazla yaklaşan vade bildirimi (ör. 3 ve 2 gün önce), vade günü
  // ve gecikmede periyodik tekrar aynı otomasyon kuralının parçalarıdır.
  paymentReminderDaysBefore       Int[]               @default([3])
  paymentReminderOnDueDate        Boolean             @default(true)
  paymentReminderOverdueEnabled   Boolean             @default(true)
  paymentReminderOverdueEveryDays Int                 @default(3)
  // Değerlendirme (ANKET) SMS şablonunda {{surveyLink}} yer tutucusu için
  // kliniğin kendi belirlediği bağlantı (ör. Google yorum linki). Opsiyonel.
  reviewLink                      String?
  // Doğum günü olan hastalara otomatik kutlama SMS'i (bkz. src/lib/birthday-reminders.ts).
  birthdaySmsEnabled              Boolean             @default(false)
  // Otomatik bildirimlerin (randevu, hatırlatma, ödeme vb.) varsayılan olarak
  // hangi kanaldan gideceği. Yalnızca Institution.whatsappEnabled açık kliniklerde
  // WHATSAPP seçilebilir; kapalıysa merkezi servis her zaman SMS'e düşer
  // (bkz. src/lib/notification-dispatch.ts).
  defaultNotificationChannel      NotificationChannel @default(SMS)
  whatsappSmsFallback             Boolean             @default(true)
  whatsappAppointmentEnabled      Boolean             @default(true)
  whatsappPaymentEnabled          Boolean             @default(true)
  whatsappInfoEnabled             Boolean             @default(true)
  updatedAt                       DateTime            @updatedAt
  institutionId                   String              @unique
  activePriceList                 String              @default("standard")
  followUpCustomTypes             String              @default("[]")
  institution                     Institution         @relation(fields: [institutionId], references: [id])
}

// Kuruma özel randevu tedavi türleri ve renkleri (Ayarlar > Tedavi Türleri)
model TreatmentType {
  id            String      @id @default(cuid())
  institutionId String
  value         String
  label         String
  color         String      @default("#2563eb")
  order         Int         @default(0)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([institutionId, value])
  @@index([institutionId, order])
}

// Doktor bazlı zaman blokajı (belirli tarih/saat aralığında randevuya kapalı)
model DoctorBlock {
  id            String       @id @default(cuid())
  institutionId String
  branchId      String
  doctorId      String
  date          String // YYYY-MM-DD
  startTime     String // HH:mm
  endTime       String // HH:mm
  reason        String?
  createdAt     DateTime     @default(now())
  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  branch        ClinicBranch @relation(fields: [branchId, institutionId], references: [id, institutionId], onDelete: Cascade)
  doctor        User         @relation(fields: [doctorId, institutionId], references: [id, institutionId], onDelete: NoAction)

  @@index([institutionId, branchId, doctorId, date])
}

model SupportTicket {
  id            String       @id @default(cuid())
  userId        String?
  institutionId String?
  subject       String
  message       String
  answer        String?
  status        String       @default("OPEN")
  closedAt      DateTime?
  closedById    String?
  createdAt     DateTime     @default(now())
  user          User?        @relation(fields: [userId], references: [id])
  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([institutionId])
  @@index([institutionId, status, createdAt])
}

model Message {
  id            String       @id @default(cuid())
  userId        String
  institutionId String
  branchId      String
  text          String
  deletedAt     DateTime?
  deletedById   String?
  createdAt     DateTime     @default(now())
  user          User         @relation(fields: [userId, institutionId], references: [id, institutionId], onDelete: NoAction)
  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  branch        ClinicBranch @relation(fields: [branchId, institutionId], references: [id, institutionId], onDelete: Cascade)

  @@index([userId])
  @@index([institutionId, branchId, createdAt])
  @@index([institutionId, branchId, deletedAt, createdAt])
}

model Announcement {
  id            String       @id @default(cuid())
  institutionId String?
  text          String
  isActive      Boolean      @default(true)
  startsAt      DateTime?
  endsAt        DateTime?
  createdById   String?
  createdAt     DateTime     @default(now())
  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([institutionId, isActive, createdAt])
}

model Prescription {
  id            String       @id @default(cuid())
  institutionId String
  branchId      String
  requestKey    String?
  patientId     String
  doctorId      String?
  drugs         String
  note          String?
  status        String       @default("ACTIVE")
  voidedAt      DateTime?
  voidedById    String?
  voidReason    String?
  createdAt     DateTime     @default(now())
  patient       Patient      @relation(fields: [patientId, institutionId, branchId], references: [id, institutionId, homeBranchId], onDelete: NoAction)
  doctor        User?        @relation("PrescriptionDoctor", fields: [doctorId, institutionId], references: [id, institutionId], onDelete: NoAction)
  institution   Institution  @relation(fields: [institutionId], references: [id])
  branch        ClinicBranch @relation(fields: [branchId, institutionId], references: [id, institutionId])

  @@index([institutionId, branchId, patientId])
  @@index([institutionId, branchId, status, createdAt])
  @@index([doctorId])
  @@unique([branchId, requestKey])
  @@unique([id, institutionId, branchId])
}

model TreatmentPlan {
  id            String              @id @default(cuid())
  institutionId String
  branchId      String
  requestKey    String?
  patientId     String
  doctorId      String
  title         String
  status        TreatmentPlanStatus @default(PLANLANDI)
  totalCost     Decimal?            @db.Decimal(10, 2)
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  doctor        User                @relation("TreatmentPlanDoctor", fields: [doctorId, institutionId], references: [id, institutionId], onDelete: NoAction)
  patient       Patient             @relation(fields: [patientId, institutionId, branchId], references: [id, institutionId, homeBranchId], onDelete: NoAction)
  institution   Institution         @relation(fields: [institutionId], references: [id])
  branch        ClinicBranch        @relation(fields: [branchId, institutionId], references: [id, institutionId])
  steps         TreatmentStep[]

  @@unique([id, institutionId, branchId])
  @@unique([branchId, requestKey])
  @@index([institutionId, branchId, patientId])
  @@index([doctorId])
}

model TreatmentStep {
  id            String        @id @default(cuid())
  institutionId String
  branchId      String
  planId        String
  order         Int
  treatmentName String
  toothNo       String?
  amount        Decimal       @db.Decimal(10, 2)
  status        String        @default("BEKLIYOR")
  doneAt        DateTime?
  note          String?
  archivedAt    DateTime?
  archivedById  String?
  archiveReason String?
  createdAt     DateTime      @default(now())
  institution   Institution   @relation(fields: [institutionId], references: [id], onDelete: NoAction)
  branch        ClinicBranch  @relation(fields: [branchId, institutionId], references: [id, institutionId], onDelete: NoAction)
  plan          TreatmentPlan @relation(fields: [planId, institutionId, branchId], references: [id, institutionId, branchId], onDelete: Cascade)

  @@index([planId])
  @@index([planId, archivedAt])
}

// Kurumun sattığı, yeniden kullanılabilir paket şablonu (ör. "6 Seans
// Detertraj Paketi"). Satış anında PatientPackage bu şablondan bir kopya
// alır (name/sessionCount/price snapshot) — tanım sonradan değişse veya
// pasifleştirilse bile önceden satılmış paketlerin koşulları değişmez.
model PackageDefinition {
  id              String           @id @default(cuid())
  institutionId   String
  name            String
  treatmentType   String?
  sessionCount    Int
  price           Decimal          @db.Decimal(10, 2)
  validityDays    Int              @default(365)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  institution     Institution      @relation(fields: [institutionId], references: [id])
  patientPackages PatientPackage[]

  @@unique([id, institutionId])
  @@index([institutionId])
}

// Bir hastaya satılmış paket örneği — kalan/kullanılan seans sayısını ve
// (varsa) bağlı ödeme/taksit planını takip eder. "Otomatik borçlandırma":
// satış anında ya tek seferlik bir Payment ya da (peşinat tam değilse) bir
// TaksitPlan otomatik oluşturulur; ikisi de muhasebe ekranında normal bir
// tahsilat/taksit gibi görünür, ayrı bir "paket geliri" silosu yoktur.
model PatientPackage {
  id            String                @id @default(cuid())
  requestKey    String?
  institutionId String
  branchId      String
  patientId     String
  definitionId  String?
  doctorId      String?
  name          String
  sessionsTotal Int
  sessionsUsed  Int                   @default(0)
  totalPrice    Decimal               @db.Decimal(10, 2)
  purchasedAt   DateTime              @default(now())
  expiresAt     DateTime?
  status        PatientPackageStatus  @default(AKTIF)
  note          String?
  paymentId     String?               @unique
  taksitPlanId  String?               @unique
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  institution   Institution           @relation(fields: [institutionId], references: [id])
  branch        ClinicBranch          @relation(fields: [branchId, institutionId], references: [id, institutionId])
  patient       Patient               @relation(fields: [patientId, institutionId, branchId], references: [id, institutionId, homeBranchId], onDelete: NoAction)
  definition    PackageDefinition?    @relation(fields: [definitionId, institutionId], references: [id, institutionId], onDelete: NoAction)
  doctor        User?                 @relation("PatientPackageDoctor", fields: [doctorId, institutionId], references: [id, institutionId], onDelete: NoAction)
  payment       Payment?              @relation(fields: [paymentId, institutionId, branchId], references: [id, institutionId, branchId], onDelete: NoAction)
  taksitPlan    TaksitPlan?           @relation(fields: [taksitPlanId, institutionId, branchId], references: [id, institutionId, branchId], onDelete: NoAction)
  usages        PatientPackageUsage[]

  @@unique([branchId, requestKey])
  @@unique([id, institutionId, branchId])
  @@unique([paymentId, institutionId, branchId])
  @@unique([taksitPlanId, institutionId, branchId])
  @@index([institutionId, branchId])
  @@index([patientId])
  @@index([status])
}

// Paketten bir seansın "harcandığı" an — mümkünse ilgili randevuya bağlanır,
// böylece paket kullanımı ile randevu geçmişi arasında iz kaybolmaz.
model PatientPackageUsage {
  id               String         @id @default(cuid())
  institutionId    String
  branchId         String
  requestKey       String?
  patientPackageId String
  appointmentId    String?
  usedAt           DateTime       @default(now())
  note             String?
  status           String         @default("ACTIVE")
  voidedAt         DateTime?
  createdById      String?
  institution      Institution    @relation(fields: [institutionId], references: [id], onDelete: NoAction)
  branch           ClinicBranch   @relation(fields: [branchId, institutionId], references: [id, institutionId], onDelete: NoAction)
  patientPackage   PatientPackage @relation(fields: [patientPackageId, institutionId, branchId], references: [id, institutionId, branchId], onDelete: Cascade)
  appointment      Appointment?   @relation(fields: [appointmentId, institutionId, branchId], references: [id, institutionId, branchId], onDelete: NoAction)
  createdBy        User?          @relation("PatientPackageUsageCreatedBy", fields: [createdById, institutionId], references: [id, institutionId], onDelete: NoAction)

  // Aynı randevu için aynı paketten iki kez seans düşülmesin.
  @@unique([patientPackageId, appointmentId])
  @@unique([branchId, requestKey])
  @@index([patientPackageId])
  @@index([appointmentId])
  @@index([patientPackageId, status])
}

model LabOrder {
  id            String            @id @default(cuid())
  institutionId String
  branchId      String
  requestKey    String?
  patientId     String
  doctorId      String
  // labName tarihsel/gösterim amaçlı serbest metin olarak kalır; asıl ilişki
  // firmaId ile kurulur (bkz. denetim raporu Tema 3 — önceden yalnızca isim
  // eşleşmesiyle kuruluyordu, firma adı değişince zincir kopabiliyordu).
  labName       String
  firmaId       String?
  labType       String
  teeth         String?
  notes         String?
  status        LabOrderStatus    @default(DEVAM_EDIYOR)
  price         Decimal?          @db.Decimal(10, 2)
  invoiceNo     String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  doctor        User              @relation("LabOrderDoctor", fields: [doctorId, institutionId], references: [id, institutionId], onDelete: NoAction)
  institution   Institution       @relation(fields: [institutionId], references: [id])
  branch        ClinicBranch      @relation(fields: [branchId, institutionId], references: [id, institutionId])
  firma         Firma?            @relation(fields: [firmaId, institutionId, branchId], references: [id, institutionId, branchId], onDelete: NoAction)
  invoices      LabOrderInvoice[]
  patient       Patient           @relation(fields: [patientId, institutionId, branchId], references: [id, institutionId, homeBranchId], onDelete: NoAction)
  trips         LabTrip[]
  followUps     PatientFollowUp[]

  @@unique([branchId, requestKey])
  @@index([institutionId, branchId, patientId])
  @@index([doctorId])
  @@index([firmaId])
  @@unique([id, institutionId, branchId])
}

model LabTrip {
  id            String            @id @default(cuid())
  institutionId String
  branchId      String
  labOrderId    String
  order         Int
  description   String
  sentAt        DateTime          @default(now())
  expectedAt    DateTime?
  followUps     PatientFollowUp[]
  receivedAt    DateTime?
  sentNote      String?
  receivedNote  String?
  createdAt     DateTime          @default(now())
  institution   Institution       @relation(fields: [institutionId], references: [id], onDelete: NoAction)
  branch        ClinicBranch      @relation(fields: [branchId, institutionId], references: [id, institutionId], onDelete: NoAction)
  labOrder      LabOrder          @relation(fields: [labOrderId, institutionId, branchId], references: [id, institutionId, branchId], onDelete: Cascade)

  @@unique([labOrderId, order])
  @@unique([id, institutionId, branchId])
  @@index([labOrderId])
}

model LabOrderInvoice {
  id            String       @id @default(cuid())
  institutionId String
  branchId      String
  labOrderId    String
  requestKey    String?
  item          String
  amount        Decimal      @db.Decimal(10, 2)
  invoiceNo     String?
  issuedAt      DateTime     @default(now())
  note          String?
  status        String       @default("ACTIVE")
  voidedAt      DateTime?
  voidedById    String?
  voidReason    String?
  createdAt     DateTime     @default(now())
  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: NoAction)
  branch        ClinicBranch @relation(fields: [branchId, institutionId], references: [id, institutionId], onDelete: NoAction)
  labOrder      LabOrder     @relation(fields: [labOrderId, institutionId, branchId], references: [id, institutionId, branchId], onDelete: Cascade)

  // Postgres'te unique indekste NULL değerler birbirinden farklı sayılır —
  // yani bu kısıt yalnızca gerçek bir invoiceNo GİRİLDİĞİNDE aynı siparişte
  // tekrarını engeller. invoiceNo boş bırakılan (henüz numara atanmamış /
  // fatura dışı maliyet kalemi) satırlar sayıca sınırsızdır — bu bilinçli bir
  // tasarımdır (bkz. denetim raporu), çünkü bir laboratuvar siparişine birden
  // fazla numarasız maliyet kalemi eklenebilmesi gerekir.
  @@unique([labOrderId, invoiceNo])
  @@unique([id, institutionId, branchId])
  @@unique([branchId, requestKey])
  @@index([labOrderId])
  @@index([issuedAt])
  @@index([labOrderId, status])
}

model StockItem {
  id              String          @id @default(cuid())
  institutionId   String
  branchId        String
  name            String
  category        String          @default("SARF")
  unit            String          @default("adet")
  quantity        Int             @default(0)
  minQuantity     Int             @default(5)
  unitPrice       Decimal?        @db.Decimal(10, 2)
  supplier        String?
  barcode         String?
  expiresAt       DateTime?
  storageLocation String?
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  institution     Institution     @relation(fields: [institutionId], references: [id])
  branch          ClinicBranch    @relation(fields: [branchId, institutionId], references: [id, institutionId])
  movements       StockMovement[]
  purchaseItems   PurchaseItem[]
  lots            StockLot[]

  // Aynı isimde birden fazla stok kartı açılabiliyordu (satın almadaki
  // eşleştirme mantığı büyük/küçük harf duyarsızdı ama veritabanında bunu
  // garanti eden bir kısıt yoktu — eşzamanlı iki "yeni ürün" isteği veya
  // "Yeni Kart" formundan elle tekrar aynı isim girilmesi mükerrer kart
  // yaratabiliyordu). Firma modeliyle aynı desen.
  @@unique([branchId, name])
  @@unique([id, institutionId, branchId])
  @@index([institutionId, branchId])
  @@index([barcode])
  @@index([expiresAt])
}

model StockMovement {
  id             String                       @id @default(cuid())
  stockItemId    String
  institutionId  String
  branchId       String
  requestKey     String?
  type           StockMovementType
  quantity       Int
  unitPrice      Decimal?                     @db.Decimal(10, 2)
  supplier       String?
  note           String?
  userId         String
  createdAt      DateTime                     @default(now())
  stockItem      StockItem                    @relation(fields: [stockItemId, institutionId, branchId], references: [id, institutionId, branchId], onDelete: NoAction)
  institution    Institution                  @relation(fields: [institutionId], references: [id])
  branch         ClinicBranch                 @relation(fields: [branchId, institutionId], references: [id, institutionId])
  user           User                         @relation("StockMovementUser", fields: [userId, institutionId], references: [id, institutionId], onDelete: NoAction)
  purchaseItem   PurchaseItem?
  lotAllocations StockMovementLotAllocation[]

  @@unique([branchId, requestKey])
  @@unique([id, institutionId, branchId])
  @@index([institutionId, branchId, createdAt])
  @@index([stockItemId, createdAt])
}

model StockLot {
  id                String                       @id @default(cuid())
  institutionId     String
  branchId          String
  stockItemId       String
  purchaseItemId    String?
  lotNo             String?
  receivedAt        DateTime
  expiresAt         DateTime?
  quantityReceived  Int
  quantityRemaining Int
  unitCost          Decimal                      @db.Decimal(10, 2)
  supplierName      String?
  status            StockLotStatus               @default(AKTIF)
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  institution       Institution                  @relation(fields: [institutionId], references: [id])
  branch            ClinicBranch                 @relation(fields: [branchId, institutionId], references: [id, institutionId])
  stockItem         StockItem                    @relation(fields: [stockItemId, institutionId, branchId], references: [id, institutionId, branchId], onDelete: NoAction)
  purchaseItem      PurchaseItem?                @relation(fields: [purchaseItemId, institutionId, branchId], references: [id, institutionId, branchId], onDelete: NoAction)
  allocations       StockMovementLotAllocation[]

  @@index([institutionId, branchId, stockItemId, status])
  @@index([stockItemId, expiresAt, receivedAt])
  @@index([purchaseItemId])
  @@unique([id, institutionId, branchId])
}

model StockMovementLotAllocation {
  id            String        @id @default(cuid())
  institutionId String
  branchId      String
  movementId    String
  lotId         String
  quantity      Int
  unitCost      Decimal       @db.Decimal(10, 2)
  createdAt     DateTime      @default(now())
  institution   Institution   @relation(fields: [institutionId], references: [id], onDelete: NoAction)
  branch        ClinicBranch  @relation(fields: [branchId, institutionId], references: [id, institutionId], onDelete: NoAction)
  movement      StockMovement @relation(fields: [movementId, institutionId, branchId], references: [id, institutionId, branchId], onDelete: Cascade)
  lot           StockLot      @relation(fields: [lotId, institutionId, branchId], references: [id, institutionId, branchId], onDelete: NoAction)

  @@unique([movementId, lotId])
  @@index([lotId])
}

model TaksitPlan {
  id             String           @id @default(cuid())
  institutionId  String
  branchId       String
  patientId      String
  doctorId       String
  baslik         String?
  toplamBorc     Decimal          @db.Decimal(10, 2)
  pesnat         Decimal          @default(0) @db.Decimal(10, 2)
  taksitSayisi   Int
  period         TaksitPeriod     @default(AYLIK)
  startDate      DateTime
  notes          String?
  status         TaksitPlanStatus @default(AKTIF)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  reminders      Reminder[]
  taksitler      Taksit[]
  doctor         User             @relation("TaksitPlanDoctor", fields: [doctorId, institutionId], references: [id, institutionId], onDelete: NoAction)
  patient        Patient          @relation(fields: [patientId, institutionId, branchId], references: [id, institutionId, homeBranchId], onDelete: NoAction)
  institution    Institution      @relation(fields: [institutionId], references: [id])
  branch         ClinicBranch     @relation(fields: [branchId, institutionId], references: [id, institutionId])
  patientPackage PatientPackage?

  @@index([institutionId, branchId, patientId])
  @@index([doctorId])
  @@index([status])
  @@unique([id, institutionId, branchId])
}

model Taksit {
  id           String              @id @default(cuid())
  institutionId String
  branchId     String
  planId       String
  siraNo       Int
  vadeDate     DateTime
  tutar        Decimal             @db.Decimal(10, 2)
  odenen       Decimal             @default(0) @db.Decimal(10, 2)
  kalan        Decimal             @db.Decimal(10, 2)
  status       TaksitStatus        @default(BEKLIYOR)
  note         String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  institution  Institution         @relation(fields: [institutionId], references: [id], onDelete: NoAction)
  branch       ClinicBranch        @relation(fields: [branchId, institutionId], references: [id, institutionId], onDelete: NoAction)
  plan         TaksitPlan          @relation(fields: [planId, institutionId, branchId], references: [id, institutionId, branchId], onDelete: Cascade)
  odemeler     TaksitOdeme[]
  reminderLogs TaksitReminderLog[]

  @@index([planId])
  @@index([vadeDate])
  @@index([status])
  @@unique([id, institutionId, branchId])
}

model TaksitOdeme {
  id            String        @id @default(cuid())
  institutionId String
  branchId      String
  taksitId      String
  paymentId     String?
  tarih         DateTime      @default(now())
  tutar         Decimal       @db.Decimal(10, 2)
  yontem        PaymentMethod @default(NAKIT)
  posId         String?
  note          String?
  status        String        @default("ACTIVE")
  voidedAt      DateTime?
  createdAt     DateTime      @default(now())
  institution   Institution   @relation(fields: [institutionId], references: [id], onDelete: NoAction)
  branch        ClinicBranch  @relation(fields: [branchId, institutionId], references: [id, institutionId], onDelete: NoAction)
  payment       Payment?      @relation(fields: [paymentId, institutionId, branchId], references: [id, institutionId, branchId], onDelete: NoAction)
  pos           PosDevice?    @relation(fields: [posId, institutionId, branchId], references: [id, institutionId, branchId], onDelete: NoAction)
  taksit        Taksit        @relation(fields: [taksitId, institutionId, branchId], references: [id, institutionId, branchId], onDelete: Cascade)

  @@index([taksitId])
  @@index([paymentId])
  @@index([taksitId, status])
}

// Bir taksit için otomatik SMS hatırlatması ne zaman gönderildi — aynı taksite
// saatlik taramada tekrar tekrar SMS gitmesin diye (bkz. InvoiceReminder ile
// aynı desen, src/lib/patient-payment-reminders.ts).
model TaksitReminderLog {
  id            String       @id @default(cuid())
  institutionId String
  branchId      String
  taksitId      String
  sentTo        String
  status        String
  errorDetail   String?
  sentAt        DateTime     @default(now())
  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: NoAction)
  branch        ClinicBranch @relation(fields: [branchId, institutionId], references: [id, institutionId], onDelete: NoAction)
  taksit        Taksit       @relation(fields: [taksitId, institutionId, branchId], references: [id, institutionId, branchId], onDelete: Cascade)

  @@index([taksitId])
}

// Bir hastaya doğum günü SMS'i hangi yıl gönderildi — @@unique([patientId, year])
// yılda-bir-kez gönderim garantisini DB seviyesinde sağlar (saatlik tarama aynı
// gün birden fazla kez çalışsa bile ikinci kez göndermez), bkz. src/lib/birthday-reminders.ts.
model BirthdaySmsLog {
  id            String       @id @default(cuid())
  institutionId String
  branchId      String
  patientId     String
  year          Int
  sentTo        String
  status        String
  errorDetail   String?
  sentAt        DateTime     @default(now())
  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: NoAction)
  branch        ClinicBranch @relation(fields: [branchId, institutionId], references: [id, institutionId], onDelete: NoAction)
  patient       Patient      @relation(fields: [patientId, institutionId, branchId], references: [id, institutionId, homeBranchId], onDelete: NoAction)

  @@unique([patientId, year])
}

// Süperadmin'in yönettiği, sistem geneli meslek/resmi gün kutlama kataloğu
// (ör. Tıp Bayramı, Öğretmenler Günü, Yılbaşı). targetProfessions boşsa
// (resmi bayram gibi) tüm hastalara, doluysa yalnızca listede meslek alanı
// eşleşen hastalara gönderilir (bkz. src/lib/professions.ts — meslek artık
// hasta formunda sabit bir listeden seçilir, bu yüzden tam eşleşme güvenilirdir).
// Klinikler bu kataloğun her satırını CelebrationDaySetting ile ayrı ayrı
// açar/kapatır — varsayılan kapalı (bkz. Setting.birthdaySmsEnabled felsefesi:
// SMS bakiyesi tükettiği için bilinçli açılmalı).
model CelebrationDay {
  id                       String                  @id @default(cuid())
  code                     String                  @unique
  title                    String
  category                 String                  @default("GENERAL")
  month                    Int
  day                      Int
  recurrenceRule           String                  @default("FIXED")
  weekOfMonth              Int?
  weekday                  Int?
  dateOverrides            String[]                @default([])
  targetProfessions        String[]                @default([])
  messageTemplate          String
  whatsappMessageTemplate  String?
  whatsappTemplateName     String?
  whatsappTemplateLanguage String                  @default("tr")
  isActive                 Boolean                 @default(true)
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  settings                 CelebrationDaySetting[]
}

model CelebrationDaySetting {
  id              String         @id @default(cuid())
  institutionId   String
  celebrationCode String
  enabled         Boolean        @default(false)
  updatedAt       DateTime       @updatedAt
  institution     Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  celebrationDay  CelebrationDay @relation(fields: [celebrationCode], references: [code], onDelete: Cascade)

  @@unique([institutionId, celebrationCode])
}

// BirthdaySmsLog ile aynı desen — yılda-bir-kez gönderim garantisi
// @@unique([patientId, celebrationCode, year]) ile DB seviyesinde sağlanır.
model CelebrationSmsLog {
  id              String   @id @default(cuid())
  institutionId   String
  branchId        String
  patientId       String
  celebrationCode String
  year            Int
  sentTo          String
  status          String
  errorDetail     String?
  sentAt          DateTime @default(now())
  institution     Institution @relation(fields: [institutionId], references: [id], onDelete: NoAction)
  branch          ClinicBranch @relation(fields: [branchId, institutionId], references: [id, institutionId], onDelete: NoAction)
  patient         Patient  @relation(fields: [patientId, institutionId, branchId], references: [id, institutionId, homeBranchId], onDelete: NoAction)

  @@unique([patientId, celebrationCode, year])
}

// Hastanın kliniğe SMS ile iletişim kurulmasına verdiği güncel iznin anlık
// görünümü. Tek bir onay; randevu/hatırlatma/ödeme/doğum günü/bayram gibi
// bütün hizmet ve kutlama SMS'lerini kapsar (bkz. docs/ILETISIM-MIMARISI-RAPORU.md
// §1). Bu tabloyu hiçbir ekran doğrudan güncellemez — yalnızca merkezi
// dispatch servisi (src/lib/notification-dispatch.ts) ve onay linki/token
// akışı günceller; personel manuel olarak ONAYLANDI/REDDEDILDI yazamaz,
// yalnızca yeni bir token üretip tekrar gönderim tetikleyebilir.
model PatientSmsPreference {
  id                   String                  @id @default(cuid())
  institutionId        String
  patientId            String                  @unique
  status               SmsConsentStatus        @default(PENDING)
  firstConsentAt       DateTime?
  lastRejectionAt      DateTime?
  lastRequestSentAt    DateTime?
  // Son gönderim DENEMESİ (başarılı ya da başarısız) — hasta kartında "Onay
  // Bekliyor" durumunun aslında hiç gönderilememiş bir SMS'i başarılıymış gibi
  // göstermesini önlemek için lastRequestSentAt'tan (yalnızca başarı) ayrı tutulur.
  lastRequestAttemptAt DateTime?
  lastRequestError     String?
  consentTokenId       String?
  lastChangeSource     SmsConsentSource        @default(SYSTEM_MIGRATION)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  patient              Patient                 @relation(fields: [patientId, institutionId], references: [id, institutionId], onDelete: NoAction)
  consentToken         PatientSmsConsentToken? @relation(fields: [consentTokenId, institutionId], references: [id, institutionId], onDelete: NoAction)

  @@index([institutionId])
  @@index([institutionId, status])
  @@unique([patientId, institutionId])
}

// Tercih geçmişini silmeden tutan ekleme temelli audit tablosu — eski
// olaylar hiçbir zaman güncellenmez veya silinmez.
model PatientSmsPreferenceEvent {
  id            String            @id @default(cuid())
  institutionId String
  patientId     String
  oldStatus     SmsConsentStatus?
  newStatus     SmsConsentStatus
  source        SmsConsentSource
  tokenId       String?
  ipHash        String?
  createdAt     DateTime          @default(now())
  patient       Patient           @relation(fields: [patientId, institutionId], references: [id, institutionId], onDelete: NoAction)

  @@index([institutionId, createdAt])
  @@index([patientId, createdAt])
}

// Onay linkindeki güvenli, tek kullanımlık, süreli token. Düz metin token
// hiçbir zaman saklanmaz — yalnızca SHA-256 hash'i tutulur (bkz.
// src/lib/sms-consent-token.ts). Giriş gerektirmeyen /sms-onay/[token]
// sayfası bu tabloyu doğrular.
model PatientSmsConsentToken {
  id            String                 @id @default(cuid())
  institutionId String
  patientId     String
  tokenHash     String                 @unique
  purpose       SmsConsentTokenPurpose @default(INITIAL)
  expiresAt     DateTime
  usedAt        DateTime?
  usedFromIp    String?
  usedUserAgent String?
  resultStatus  SmsConsentStatus?
  // Bu hasta için daha yeni bir token üretildiğinde eski, henüz kullanılmamış
  // token'lar burada işaretlenir — hasta eski bağlantıdan hâlâ onay/ret
  // verebilirse iki farklı bağlantıdan çelişkili sonuç oluşabilirdi (bkz.
  // docs/ILETISIM-MIMARISI-RAPORU.md §1.6 taşma senaryosu).
  invalidatedAt DateTime?
  createdById   String?
  createdAt     DateTime               @default(now())
  patient       Patient                @relation(fields: [patientId, institutionId], references: [id, institutionId], onDelete: NoAction)
  preferences   PatientSmsPreference[]

  @@unique([id, institutionId])
  @@index([institutionId])
  @@index([patientId, createdAt])
}

// Merkezi dispatch servisinden geçen her SMS/WhatsApp gönderiminin tek
// gerçek kaynağı (bkz. src/lib/notification-dispatch.ts). idempotencyKey
// aynı olayın ikinci kez gönderilmesini DB seviyesinde de engeller. İzin
// olmadığı için gönderilmeyen mesajlar da (SUPPRESSED) burada, sağlayıcıya
// hiç ulaşmadan kaydedilir.
model SmsDispatch {
  id                String              @id @default(cuid())
  institutionId     String
  branchId          String
  patientId         String
  channel           NotificationChannel
  eventType         String
  purpose           SmsDispatchPurpose
  phoneMasked       String
  messageHash       String
  idempotencyKey    String
  status            SmsDispatchStatus   @default(QUEUED)
  providerCode      String?
  providerMessageId String?
  attemptCount      Int                 @default(0)
  lastError         String?
  scheduledFor      DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  createdById       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  institution       Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  branch            ClinicBranch        @relation(fields: [branchId, institutionId], references: [id, institutionId], onDelete: NoAction)
  patient           Patient             @relation(fields: [patientId, institutionId, branchId], references: [id, institutionId, homeBranchId], onDelete: Cascade)

  @@unique([institutionId, idempotencyKey])
  @@index([institutionId, createdAt])
  @@index([institutionId, branchId, createdAt])
  @@index([patientId, createdAt])
}

model PosDevice {
  id             String        @id @default(cuid())
  institutionId  String
  branchId       String
  name           String
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  institution    Institution   @relation(fields: [institutionId], references: [id])
  branch         ClinicBranch  @relation(fields: [branchId, institutionId], references: [id, institutionId])
  payments       Payment[]
  taksitOdemeler TaksitOdeme[]

  @@unique([branchId, name])
  @@unique([id, institutionId, branchId])
  @@index([institutionId, branchId])
}

model ExpenseCategory {
  id             String      @id @default(cuid())
  institutionId  String
  name           String
  isActive       Boolean     @default(true)
  // Bu tür seçildiğinde gider formu doktor + hakediş dönemi (yıl/ay) alanlarını
  // gösterir ve kayıt o doktorun aylık hakediş bakiyesinden düşülür.
  isDoctorPayout Boolean     @default(false)
  createdAt      DateTime    @default(now())
  institution    Institution @relation(fields: [institutionId], references: [id])
  expenses       Expense[]

  @@unique([institutionId, name])
  @@unique([id, institutionId])
  @@index([institutionId])
}

model Expense {
  id              String           @id @default(cuid())
  institutionId   String
  branchId        String
  requestKey      String?
  tarih           DateTime
  categoryId      String?
  category        String
  description     String?
  tutar           Decimal          @db.Decimal(10, 2)
  yontem          PaymentMethod    @default(NAKIT)
  faturaNo        String?
  kdvOrani        Int              @default(0)
  status          AktifIptalStatus @default(AKTIF)
  sourceType      String?
  sourceId        String?
  // Doktor hakediş ödemesi kayıtları için: hangi doktora, hangi hakediş dönemine
  // (yıl/ay) ait olduğu. İkisi de null ise normal (doktora bağlı olmayan) gider.
  doctorId        String?
  periodYear      Int?
  periodMonth     Int?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  institution     Institution      @relation(fields: [institutionId], references: [id])
  branch          ClinicBranch     @relation(fields: [branchId, institutionId], references: [id, institutionId])
  expenseCategory ExpenseCategory? @relation(fields: [categoryId, institutionId], references: [id, institutionId], onDelete: NoAction)
  doctor          User?            @relation("ExpenseDoctor", fields: [doctorId, institutionId], references: [id, institutionId], onDelete: NoAction)

  @@unique([branchId, sourceType, sourceId])
  @@unique([branchId, requestKey])
  @@index([institutionId, branchId])
  @@index([tarih])
  @@index([status])
  @@index([doctorId, periodYear, periodMonth])
  @@unique([id, institutionId, branchId])
}

model Firma {
  id                 String                   @id @default(cuid())
  institutionId      String
  branchId           String
  name               String
  phone              String?
  iban               String?
  ibanName           String?
  notes              String?
  kategori           FirmaKategori            @default(TEDARICI)
  paymentTerms       PaymentTermType?         @default(NET_30)
  customPaymentDays  Int?
  vendorScore        Int                      @default(0)
  scoreUpdatedAt     DateTime?
  isActive           Boolean                  @default(true)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  institution        Institution              @relation(fields: [institutionId], references: [id])
  branch             ClinicBranch             @relation(fields: [branchId, institutionId], references: [id, institutionId])
  islemler           FirmaIslem[]
  kontaktler         FirmaKontakt[]
  purchases          Purchase[]
  labOrders          LabOrder[]
  paymentAllocations FirmaPaymentAllocation[]

  @@unique([branchId, name])
  @@unique([id, institutionId, branchId])
  @@index([institutionId, branchId])
  @@index([kategori])
  @@index([vendorScore])
}

model FirmaIslem {
  id                 String                   @id @default(cuid())
  institutionId      String
  branchId           String
  firmaId            String
  requestKey         String?
  tarih              DateTime
  islemTipi          FirmaIslemTipi           @default(ALIM)
  urunHizmet         String?
  aciklama           String?
  tutar              Decimal                  @db.Decimal(10, 2)
  faturaNo           String?
  yontem             PaymentMethod?
  dueDate            DateTime?
  kdvOrani           Int                      @default(0)
  status             AktifIptalStatus         @default(AKTIF)
  sourceType         String?
  sourceId           String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  firma              Firma                    @relation(fields: [firmaId, institutionId, branchId], references: [id, institutionId, branchId], onDelete: NoAction)
  institution        Institution              @relation(fields: [institutionId], references: [id])
  branch             ClinicBranch             @relation(fields: [branchId, institutionId], references: [id, institutionId])
  purchase           Purchase?
  paymentAllocations FirmaPaymentAllocation[] @relation("FirmaPaymentMovement")
  debtAllocations    FirmaPaymentAllocation[] @relation("FirmaDebtMovement")

  @@unique([branchId, firmaId, sourceType, sourceId, islemTipi])
  @@unique([branchId, requestKey])
  @@index([institutionId, branchId])
  @@index([firmaId])
  @@index([tarih])
  @@index([dueDate])
  @@unique([id, institutionId, branchId])
}

model FirmaPaymentAllocation {
  id             String       @id @default(cuid())
  institutionId  String
  branchId       String
  firmaId        String
  paymentIslemId String
  debtIslemId    String
  tutar          Decimal      @db.Decimal(10, 2)
  createdAt      DateTime     @default(now())
  institution    Institution  @relation(fields: [institutionId], references: [id], onDelete: NoAction)
  branch         ClinicBranch @relation(fields: [branchId, institutionId], references: [id, institutionId], onDelete: NoAction)
  firma          Firma        @relation(fields: [firmaId, institutionId, branchId], references: [id, institutionId, branchId], onDelete: Cascade)
  paymentIslem   FirmaIslem   @relation("FirmaPaymentMovement", fields: [paymentIslemId, institutionId, branchId], references: [id, institutionId, branchId], onDelete: Cascade)
  debtIslem      FirmaIslem   @relation("FirmaDebtMovement", fields: [debtIslemId, institutionId, branchId], references: [id, institutionId, branchId], onDelete: Cascade)

  @@unique([paymentIslemId, debtIslemId])
  @@index([firmaId])
  @@index([debtIslemId])
}

model FirmaKontakt {
  id            String       @id @default(cuid())
  institutionId String
  branchId      String
  firmaId       String
  ad            String
  unvan         String?
  email         String?
  telefon       String?
  rol           String?
  isPrimary     Boolean      @default(false)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: NoAction)
  branch        ClinicBranch @relation(fields: [branchId, institutionId], references: [id, institutionId], onDelete: NoAction)
  firma         Firma        @relation(fields: [firmaId, institutionId, branchId], references: [id, institutionId, branchId], onDelete: Cascade)

  @@index([firmaId])
  @@index([email])
  @@unique([id, institutionId, branchId])
}

// Çok kalemli satın alma belgesi. Toplam tutar tek bir ALIM tipi FirmaIslem'e
// bağlanır (firma bakiyesi/ekstre hesabı hiç değişmeden çalışmaya devam eder);
// satır detayları (hangi üründen kaç adet, hangi fiyattan) burada tutulur.
model Purchase {
  id                String                @id @default(cuid())
  institutionId     String
  branchId          String
  firmaId           String
  firmaIslemId      String?               @unique
  requestKey        String?
  receiptRequestKey String?
  tarih             DateTime
  receiptStatus     PurchaseReceiptStatus @default(TESLIM_ALINDI)
  receivedAt        DateTime?
  faturaNo          String?
  aciklama          String?
  kdvOrani          Int                   @default(0)
  status            AktifIptalStatus      @default(AKTIF)
  createdById       String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  institution       Institution           @relation(fields: [institutionId], references: [id])
  branch            ClinicBranch          @relation(fields: [branchId, institutionId], references: [id, institutionId])
  firma             Firma                 @relation(fields: [firmaId, institutionId, branchId], references: [id, institutionId, branchId], onDelete: NoAction)
  firmaIslem        FirmaIslem?           @relation(fields: [firmaIslemId, institutionId, branchId], references: [id, institutionId, branchId], onDelete: NoAction)
  createdBy         User?                 @relation("PurchaseCreatedBy", fields: [createdById, institutionId], references: [id, institutionId], onDelete: NoAction)
  items             PurchaseItem[]

  @@unique([branchId, requestKey])
  @@unique([branchId, receiptRequestKey])
  @@unique([firmaIslemId, institutionId, branchId])
  @@unique([id, institutionId, branchId])
  @@index([institutionId, branchId])
  @@index([firmaId])
  @@index([tarih])
}

model PurchaseItem {
  id              String         @id @default(cuid())
  institutionId   String
  branchId        String
  purchaseId      String
  stockItemId     String
  productName     String
  quantity        Int
  unit            String         @default("adet")
  unitPrice       Decimal        @db.Decimal(10, 2)
  lineTotal       Decimal        @db.Decimal(10, 2)
  lotNo           String?
  expiresAt       DateTime?
  stockMovementId String?        @unique
  archivedAt      DateTime?
  archivedById    String?
  archiveReason   String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  institution     Institution    @relation(fields: [institutionId], references: [id], onDelete: NoAction)
  branch          ClinicBranch   @relation(fields: [branchId, institutionId], references: [id, institutionId], onDelete: NoAction)
  purchase        Purchase       @relation(fields: [purchaseId, institutionId, branchId], references: [id, institutionId, branchId], onDelete: Cascade)
  stockItem       StockItem      @relation(fields: [stockItemId, institutionId, branchId], references: [id, institutionId, branchId], onDelete: NoAction)
  stockMovement   StockMovement? @relation(fields: [stockMovementId, institutionId, branchId], references: [id, institutionId, branchId], onDelete: NoAction)
  stockLots       StockLot[]

  @@index([purchaseId])
  @@index([purchaseId, archivedAt])
  @@index([stockItemId])
  @@unique([id, institutionId, branchId])
  @@unique([stockMovementId, institutionId, branchId])
}

model Reminder {
  id            String         @id @default(cuid())
  institutionId String
  branchId      String
  patientId     String?
  planId        String?
  note          String
  reminderDate  DateTime
  status        ReminderStatus @default(AKTIF)
  attemptCount  Int            @default(0)
  lastAttemptAt DateTime?
  nextAttemptAt DateTime?
  lastError     String?
  lastChannel   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  institution   Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  branch        ClinicBranch   @relation(fields: [branchId, institutionId], references: [id, institutionId], onDelete: NoAction)
  patient       Patient?       @relation(fields: [patientId, institutionId, branchId], references: [id, institutionId, homeBranchId], onDelete: Cascade)
  plan          TaksitPlan?    @relation(fields: [planId, institutionId, branchId], references: [id, institutionId, branchId], onDelete: Cascade)

  @@index([reminderDate])
  @@index([status])
  @@index([status, reminderDate])
  @@index([status, nextAttemptAt])
  @@index([institutionId, branchId, status, reminderDate])
  @@unique([id, institutionId, branchId])
}

