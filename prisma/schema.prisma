model Waitlist {
  id            String         @id @default(cuid())
  institutionId String
  branchId      String
  patientId     String
  doctorId      String?
  createdById   String
  preferredFrom DateTime?
  preferredTo   DateTime?
  note          String?
  status        WaitlistStatus @default(BEKLIYOR)
  // YERLESTIRILDI durumuna geçerken hangi randevunun oluşturulduğu — önceden
  // bu bağ hiç tutulmuyordu, durum elle işaretleniyordu (bkz. denetim raporu
  // Tema 4).
  appointmentId String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  patient       Patient        @relation(fields: [patientId, institutionId, branchId], references: [id, institutionId, homeBranchId], onDelete: Cascade)
  doctor        User?          @relation("WaitlistDoctor", fields: [doctorId, institutionId], references: [id, institutionId], onDelete: NoAction)
  appointment   Appointment?   @relation(fields: [appointmentId, institutionId, branchId], references: [id, institutionId, branchId], onDelete: NoAction)
  createdBy     User           @relation("WaitlistCreatedBy", fields: [createdById, institutionId], references: [id, institutionId], onDelete: NoAction)
  institution   Institution    @relation(fields: [institutionId], references: [id])
  branch        ClinicBranch   @relation(fields: [branchId, institutionId], references: [id, institutionId], onDelete: Cascade)

  @@index([institutionId, branchId])
  @@index([status])
  @@index([patientId])
  @@index([appointmentId])
  @@unique([branchId, appointmentId])
  @@unique([id, institutionId, branchId])
}

enum WaitlistStatus {
  BEKLIYOR
  ARANDI
  YERLESTIRILDI
  IPTAL
}

model BookingRequest {
  id                   String               @id @default(cuid())
  institutionId        String
  branchId             String
  doctorId             String?
  fullName             String
  phone                String
  tcNo                 String?
  preferredFrom        DateTime
  preferredTo          DateTime?
  note                 String?
  status               BookingRequestStatus @default(BEKLIYOR)
  createdAppointmentId String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  doctor               User?                @relation(fields: [doctorId, institutionId], references: [id, institutionId], onDelete: NoAction)
  institution          Institution          @relation(fields: [institutionId], references: [id])
  branch               ClinicBranch         @relation(fields: [branchId, institutionId], references: [id, institutionId], onDelete: Cascade)

  @@index([institutionId, branchId])
  @@index([status])
  @@unique([id, institutionId, branchId])
}

enum BookingRequestStatus {
  BEKLIYOR
  ONAYLANDI
  REDDEDILDI
  IPTAL
}

// Hastanın SMS iznine ait güncel durum. PENDING: onay SMS'i gönderildi,
// henüz yanıt yok. EXPIRED, ayrı bir alan olarak yazılmaz — token süresi
// dolduğunda ve hasta hiç yanıt vermediğinde arayüzde türetilerek gösterilir.
enum SmsConsentStatus {
  PENDING
  ENABLED
  DISABLED
  EXPIRED
}

enum SmsConsentSource {
  PATIENT_CARD
  PUBLIC_LINK
  IMPORT
  SYSTEM_MIGRATION
}

enum SmsConsentTokenPurpose {
  INITIAL
  RESEND
}

enum SmsDispatchStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  SUPPRESSED
}

enum SmsDispatchPurpose {
  SERVICE
  GREETING
  CONSENT_REQUEST
}

enum NotificationChannel {
  SMS
  WHATSAPP
}

enum WhatsappConnectionStatus {
  NOT_CONNECTED
  CONNECTING
  CONNECTED
  ERROR
  DISCONNECTED
}
