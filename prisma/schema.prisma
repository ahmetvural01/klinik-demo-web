model Document {
  id              String           @id @default(cuid())
  institutionId   String?
  patientId       String
  uploadedById    String
  category        DocumentCategory @default(BELGE)
  fileName        String
  storedName      String           @unique
  storageProvider String           @default("LOCAL")
  sha256          String?
  mimeType        String
  fileSize        Int
  toothNo         String?
  note            String?
  createdAt       DateTime         @default(now())
  patient         Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  uploadedBy      User             @relation(fields: [uploadedById], references: [id])
  institution     Institution?     @relation(fields: [institutionId], references: [id])

  @@index([patientId])
  @@index([institutionId])
  @@index([category])
  @@index([storageProvider])
}

model DocumentBlob {
  storedName    String   @id
  encryptedData Bytes
  createdAt     DateTime @default(now())
}

enum DocumentCategory {
  BELGE
  RONTGEN
  FOTOGRAF
}

model Waitlist {
  id            String         @id @default(cuid())
  institutionId String?
  patientId     String
  doctorId      String?
  createdById   String
  preferredFrom DateTime?
  preferredTo   DateTime?
  note          String?
  status        WaitlistStatus @default(BEKLIYOR)
  // YERLESTIRILDI durumuna geçerken hangi randevunun oluşturulduğu — önceden
  // bu bağ hiç tutulmuyordu, durum elle işaretleniyordu (bkz. denetim raporu
  // Tema 4).
  appointmentId String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor        User?          @relation("WaitlistDoctor", fields: [doctorId], references: [id])
  appointment   Appointment?   @relation(fields: [appointmentId], references: [id])
  createdBy     User           @relation("WaitlistCreatedBy", fields: [createdById], references: [id])
  institution   Institution?   @relation(fields: [institutionId], references: [id])

  @@index([institutionId])
  @@index([status])
  @@index([patientId])
  @@index([appointmentId])
}

enum WaitlistStatus {
  BEKLIYOR
  ARANDI
  YERLESTIRILDI
  IPTAL
}

model BookingRequest {
  id                   String               @id @default(cuid())
  institutionId        String
  doctorId             String?
  fullName             String
  phone                String
  tcNo                 String?
  preferredFrom        DateTime
  preferredTo          DateTime?
  note                 String?
  status               BookingRequestStatus @default(BEKLIYOR)
  createdAppointmentId String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  doctor               User?                @relation(fields: [doctorId], references: [id])
  institution          Institution          @relation(fields: [institutionId], references: [id])

  @@index([institutionId])
  @@index([status])
}

enum BookingRequestStatus {
  BEKLIYOR
  ONAYLANDI
  REDDEDILDI
  IPTAL
}
